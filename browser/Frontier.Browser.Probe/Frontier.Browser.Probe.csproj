<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmAppDir>$(MSBuildThisFileDirectory)../../.runtime/browser-probe</WasmAppDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Probe the exact desktop baseline's managed code, without copying or
         modifying engine source. Native platform assemblies are not bundled. -->
    <Reference Include="OpenRA.Game"><HintPath>../../engine/bin/OpenRA.Game.dll</HintPath></Reference>
    <Reference Include="OpenRA.Mods.Common"><HintPath>../../engine/bin/OpenRA.Mods.Common.dll</HintPath></Reference>
    <Reference Include="OpenRA.Mods.Frontier"><HintPath>../../engine/bin/OpenRA.Mods.Frontier.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../../engine/bin/Newtonsoft.Json.dll</HintPath></Reference>
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" />
  </ItemGroup>
  <!-- SDK 8's incremental bundle target can retain an older JS entrypoint. -->
  <Target Name="CopyProbeWebAssets" AfterTargets="Build">
    <ItemGroup><ProbeWebAsset Include="wwwroot/**/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeWebAsset)" DestinationFolder="$(WasmAppDir)/%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
