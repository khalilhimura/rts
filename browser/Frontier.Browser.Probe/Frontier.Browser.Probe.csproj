<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BrowserEngineRoot Condition="'$(BrowserEngineRoot)' == ''">$(MSBuildThisFileDirectory)../../engine</BrowserEngineRoot>
    <WasmAppDir>$(MSBuildThisFileDirectory)../../.runtime/browser-probe</WasmAppDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the same isolated .NET 8 engine used by the browser world. -->
    <ProjectReference Include="../OpenRA.Mods.Frontier.Web/OpenRA.Mods.Frontier.Web.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" />
  </ItemGroup>
  <!-- SDK 8's incremental bundle target can retain an older JS entrypoint. -->
  <Target Name="CopyProbeWebAssets" AfterTargets="Build">
    <ItemGroup><ProbeWebAsset Include="wwwroot/**/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeWebAsset)" DestinationFolder="$(WasmAppDir)/%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
